# Copy to .env (never commit .env). Without PayPal credentials the app runs with the offline mock gateway.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock | sandbox  (default: sandbox when both credentials are set, else mock)
PAYPAL_MODE=
# Webhook ID from the sandbox app's webhook config (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
# CHF works in sandbox (verified 2026-10-25) for orders, captures, refunds and payouts
PAYPAL_CURRENCY=CHF
# Sandbox personal account email (developer.paypal.com > Testing Tools > Sandbox Accounts). Seeded customers have
# fake emails, so in sandbox mode payouts go here; without it they end UNCLAIMED (RECEIVER_UNREGISTERED).
PAYPAL_SANDBOX_PAYOUT_RECEIVER=
# Optional, tests/screenshots only: approve with this sandbox personal account instead of guest card checkout
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Public URL of the app (PayPal return/cancel redirects). Empty = taken from the request host (dev: localhost:5173)
PUBLIC_BASE_URL=

# Runtime LLM for the negotiation agent (optional; deterministic fallback when empty)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

PORT=8787
MOCK_PAYPAL_DELAY_MS=700

# Agent (see README "How AI is used")
# AGENT_MODE=deterministic forces the rule-based agent (no Claude at all)
AGENT_MODE=
LLM_EFFORT=low
# replay-or-live (default): recorded responses for the scripted demo inputs, live Claude for anything else
# replay-only: never call the API (free); unrecorded inputs fall back to rules. live-only: ignore recordings
AGENT_CACHE=
# 1 = store live responses in server/agent/llm-cache (the eval script always records)
AGENT_RECORD=
# Hard live-spend ceiling per server process (USD) and limits on LIVE Claude calls for the public demo
# (recorded replays of the scripted demo inputs are free and never counted). Over a limit -> rules fallback, shown in the UI.
AGENT_MAX_USD=0.25
AGENT_MAX_CALLS_PER_MIN=20
AGENT_MAX_LIVE_PER_SESSION_HOUR=12
AGENT_MAX_LIVE_PER_IP_HOUR=40
AGENT_MAX_LIVE_PER_DAY=300
# One in-memory demo per browser session
DEMO_SESSION_TTL_MIN=120
DEMO_MAX_SESSIONS=300
